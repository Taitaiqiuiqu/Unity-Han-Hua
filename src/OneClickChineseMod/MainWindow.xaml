<Window x:Class="OneClickChineseMod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OneClickChineseMod"
        Title="{x:Static local:AppBasicInfoManager.AppWindowTitle}"
        Width="720"
        Height="700"
        MinWidth="640"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBlackBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBlackBrush}"
                BorderBrush="{StaticResource BorderDimBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            MouseLeftButtonDown="Logo_Click" Cursor="Hand">
                    <Image x:Name="HeaderLogo"
                           Source="pack://application:,,,/Resources/Images/logo.png"
                           Width="24" Height="24"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"/>
                    <TextBlock Text="{x:Static local:AppBasicInfoManager.AppDisplayName}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavHome" Style="{StaticResource TextButtonStyle}"
                            Content="首页" Click="NavHome_Click"/>
                    <Button x:Name="NavTranslate" Style="{StaticResource TextButtonStyle}"
                            Content="汉化" Click="NavTranslate_Click"/>
                    <Button x:Name="NavConfig" Style="{StaticResource TextButtonStyle}"
                            Content="配置" Click="NavConfig_Click"/>
                    <Button x:Name="NavAbout" Style="{StaticResource TextButtonStyle}"
                            Content="关于" Click="NavAbout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Underline Indicator -->
        <Border Grid.Row="1" Background="{StaticResource SecondaryBlackBrush}"
                BorderBrush="{StaticResource BorderDimBrush}" BorderThickness="0,0,0,1">
            <Canvas x:Name="TabIndicator" Margin="24,0,0,0" Height="2" HorizontalAlignment="Left"
                    Width="40" Canvas.Top="42">
                <Border Background="{StaticResource ElectricCyanBrush}"
                        Width="40" Height="2"/>
            </Canvas>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="24,24,24,0">
            <!-- Home Page -->
            <Grid x:Name="HomePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Section -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,0">
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Image x:Name="HomeLogo"
                               Source="pack://application:,,,/Resources/Images/logo.png"
                               Width="80" Height="80"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True"
                               SnapsToDevicePixels="True"/>
                    </Grid>
                    <TextBlock Text="{x:Static local:AppBasicInfoManager.AppDisplayName}"
                               Style="{StaticResource DisplayStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static local:AppBasicInfoManager.AppSubtitle}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>
                    <TextBlock Text="{x:Static local:AppBasicInfoManager.Description}"
                               Style="{StaticResource BodyStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="500"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Feature Cards -->
                <Grid Grid.Row="1" Margin="0,48,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: 一键汉化 -->
                    <Border Grid.Column="0" Style="{StaticResource CyberCardStyle}"
                            MouseLeftButtonDown="FeatureCard_Click" Tag="translate" Cursor="Hand">
                        <StackPanel>
                            <Path Data="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                                  Stroke="{StaticResource ElectricCyanBrush}"
                                  StrokeThickness="1.5" Fill="Transparent"
                                  Width="40" Height="40" Stretch="Uniform"
                                  HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <TextBlock Text="一键汉化" Style="{StaticResource H3Style}" Margin="0,0,0,8"/>
                            <TextBlock Text="选择游戏可执行文件，自动完成检测、部署、配置全流程。" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: 灵活配置 -->
                    <Border Grid.Column="2" Style="{StaticResource CyberCardStyle}"
                            MouseLeftButtonDown="FeatureCard_Click" Tag="config" Cursor="Hand">
                        <StackPanel>
                            <Path Data="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.9c-.04-.32-.07-.64-.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z"
                                  Stroke="{StaticResource ElectricCyanBrush}"
                                  StrokeThickness="1.5" Fill="Transparent"
                                  Width="40" Height="40" Stretch="Uniform"
                                  HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <TextBlock Text="灵活配置" Style="{StaticResource H3Style}" Margin="0,0,0,8"/>
                            <TextBlock Text="支持自定义 API Key、选择翻译模型、调整翻译参数。" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: 安全可靠 -->
                    <Border Grid.Column="4" Style="{StaticResource CyberCardStyle}">
                        <StackPanel>
                            <Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                                  Stroke="{StaticResource ElectricCyanBrush}"
                                  StrokeThickness="1.5" Fill="Transparent"
                                  Width="40" Height="40" Stretch="Uniform"
                                  HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <TextBlock Text="安全可靠" Style="{StaticResource H3Style}" Margin="0,0,0,8"/>
                            <TextBlock Text="仅修改游戏目录，不影响原文件，自动备份配置。" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Translate Page -->
            <Grid x:Name="TranslatePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource H1Style}" Margin="0,0,0,8">
                        <Run Text="⚡"/><Run Text=" 一键汉化"/>
                    </TextBlock>
                    <TextBlock Text="选择游戏可执行文件，自动完成翻译插件部署"
                               Style="{StaticResource BodyStyle}"/>
                </StackPanel>

                <!-- Log Viewer -->
                <Border Grid.Row="1" Style="{StaticResource CyberCardStyle}"
                        BorderThickness="1,0,1,1" Padding="0" Margin="0,0,0,16">
                    <Grid>
                        <!-- Top Neon Line -->
                        <Border Height="1" Background="{StaticResource ElectricCyanBrush}"
                                VerticalAlignment="Top"/>
                        <!-- Log Content -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,17,16,16" MaxHeight="280">
                            <TextBlock x:Name="LogContent"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="{StaticResource SecondaryBlackBrush}"
                        BorderBrush="{StaticResource BorderDimBrush}"
                        BorderThickness="1" Padding="16,12" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Indicator -->
                        <Ellipse Grid.Column="0" x:Name="StatusIndicator"
                                 Width="8" Height="8"
                                 Fill="{StaticResource TertiaryTextBrush}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- Status Text -->
                        <TextBlock Grid.Column="1" x:Name="StatusText"
                                   Text="就绪"
                                   Style="{StaticResource BodyStyle}"
                                   VerticalAlignment="Center"/>

                        <!-- Stats -->
                        <StackPanel Grid.Column="2" x:Name="StatsPanel"
                                    Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center">
                                <Run Text="总计: "/><Run x:Name="StatTotal" Text="0"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Run Text="成功: " Foreground="{StaticResource ElectricCyanBrush}"/><Run x:Name="StatSuccess" Text="0" Foreground="{StaticResource ElectricCyanBrush}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Run Text="失败: " Foreground="{StaticResource ErrorBrush}"/><Run x:Name="StatFail" Text="0" Foreground="{StaticResource ErrorBrush}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Run Text="RPM: "/><Run x:Name="StatRpm" Text="0" Foreground="{StaticResource ElectricCyanBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button x:Name="BtnTranslate" Style="{StaticResource PrimaryButtonStyle}"
                            Content="⚡ 选择游戏并汉化" Click="BtnTranslate_Click" Margin="0,0,16,0"/>
                    <Button x:Name="BtnStop" Style="{StaticResource DangerButtonStyle}"
                            Content="■ 停止翻译" Click="BtnStop_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Config Page -->
            <Grid x:Name="ConfigPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource H1Style}" Margin="0,0,0,8">
                        <Run Text="⚙"/><Run Text=" 配置"/>
                    </TextBlock>
                    <TextBlock Text="配置 AI 翻译服务，支持多家国内模型厂商"
                               Style="{StaticResource BodyStyle}"/>
                </StackPanel>

                <!-- Config Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CyberCardStyle}">
                        <StackPanel>
                            <!-- Primary Provider Section -->
                            <TextBlock Text="主翻译服务" Style="{StaticResource H2Style}"
                                       Margin="0,0,0,16"/>
                            <Border BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="0,0,0,1" Margin="0,0,0,16" Padding="0,0,0,8"/>

                            <!-- Provider Selection -->
                            <TextBlock Text="服务厂商" Style="{StaticResource BodyStyle}"
                                       Margin="0,0,0,8"/>
                            <ComboBox x:Name="CmbProvider"
                                      Style="{StaticResource CyberComboBoxStyle}"
                                      Width="300" HorizontalAlignment="Left"
                                      SelectionChanged="CmbProvider_SelectionChanged"
                                      Margin="0,0,0,16">
                                <ComboBoxItem Content="硅基流动"/>
                                <ComboBoxItem Content="阿里通义千问"/>
                                <ComboBoxItem Content="腾讯混元"/>
                                <ComboBoxItem Content="字节豆包"/>
                                <ComboBoxItem Content="百度文心一言"/>
                                <ComboBoxItem Content="DeepSeek"/>
                            </ComboBox>

                            <!-- API Key -->
                            <TextBlock x:Name="LblApiKey" Text="API Key" Style="{StaticResource BodyStyle}"
                                       Margin="0,0,0,8"/>
                            <PasswordBox x:Name="TxtApiKey"
                                         Style="{StaticResource CyberPasswordBoxStyle}"
                                         Margin="0,0,0,8"/>
                            <TextBlock x:Name="LblApiKeyHint" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8">
                                在 cloud.siliconflow.cn 获取 API Key
                            </TextBlock>

                            <!-- Secret Key (only for Baidu Ernie) -->
                            <StackPanel x:Name="PanelSecretKey" Visibility="Collapsed">
                                <TextBlock Text="Secret Key (Client Secret)" Style="{StaticResource BodyStyle}"
                                           Margin="0,0,0,8"/>
                                <PasswordBox x:Name="TxtSecretKey"
                                             Style="{StaticResource CyberPasswordBoxStyle}"
                                             Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,0,0,8">
                                    在百度智能云控制台获取 Secret Key
                                </TextBlock>
                            </StackPanel>

                            <!-- Model Selection -->
                            <TextBlock Text="翻译模型" Style="{StaticResource BodyStyle}"
                                       Margin="0,8,0,8"/>
                            <ComboBox x:Name="CmbModel"
                                      Style="{StaticResource CyberComboBoxStyle}"
                                      Width="300" HorizontalAlignment="Left"
                                      IsEditable="True"
                                      Margin="0,0,0,24"/>

                            <!-- Fallback Provider Section -->
                            <TextBlock Text="备用翻译服务（可选）" Style="{StaticResource H2Style}"
                                       Margin="0,0,0,16"/>
                            <Border BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="0,0,0,1" Margin="0,0,0,16" Padding="0,0,0,8"/>

                            <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" TextWrapping="Wrap">
                                <Run Text="当主服务不可用时自动切换到备用服务，提高翻译稳定性"/>
                            </TextBlock>

                            <!-- Fallback Provider Selection -->
                            <TextBlock Text="备用厂商" Style="{StaticResource BodyStyle}"
                                       Margin="0,0,0,8"/>
                            <ComboBox x:Name="CmbFallbackProvider"
                                      Style="{StaticResource CyberComboBoxStyle}"
                                      Width="300" HorizontalAlignment="Left"
                                      SelectionChanged="CmbFallbackProvider_SelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="不使用备用服务"/>
                                <ComboBoxItem Content="硅基流动"/>
                                <ComboBoxItem Content="阿里通义千问"/>
                                <ComboBoxItem Content="腾讯混元"/>
                                <ComboBoxItem Content="字节豆包"/>
                                <ComboBoxItem Content="百度文心一言"/>
                                <ComboBoxItem Content="DeepSeek"/>
                            </ComboBox>

                            <!-- Fallback API Key -->
                            <TextBlock x:Name="LblFallbackApiKey" Text="备用 API Key" Style="{StaticResource BodyStyle}"
                                       Margin="0,0,0,8" Visibility="Collapsed"/>
                            <PasswordBox x:Name="TxtFallbackApiKey"
                                         Style="{StaticResource CyberPasswordBoxStyle}"
                                         Margin="0,0,0,8" Visibility="Collapsed"/>
                            <TextBlock x:Name="LblFallbackApiKeyHint" Style="{StaticResource CaptionStyle}"
                                       Margin="0,0,0,8" Visibility="Collapsed"/>

                            <!-- Fallback Secret Key -->
                            <StackPanel x:Name="PanelFallbackSecretKey" Visibility="Collapsed">
                                <TextBlock Text="备用 Secret Key" Style="{StaticResource BodyStyle}"
                                           Margin="0,0,0,8"/>
                                <PasswordBox x:Name="TxtFallbackSecretKey"
                                             Style="{StaticResource CyberPasswordBoxStyle}"
                                             Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Fallback Model Selection -->
                            <TextBlock x:Name="LblFallbackModel" Text="备用模型" Style="{StaticResource BodyStyle}"
                                       Margin="0,0,0,8" Visibility="Collapsed"/>
                            <ComboBox x:Name="CmbFallbackModel"
                                      Style="{StaticResource CyberComboBoxStyle}"
                                      Width="300" HorizontalAlignment="Left"
                                      IsEditable="True"
                                      Margin="0,0,0,24" Visibility="Collapsed"/>

                            <!-- Concurrency Control Section -->
                            <TextBlock Text="并发控制" Style="{StaticResource H2Style}"
                                       Margin="0,0,0,16"/>
                            <Border BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="0,0,0,1" Margin="0,0,0,16" Padding="0,0,0,8"/>

                            <!-- Max Concurrency Setting -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="最大并发任务数" Style="{StaticResource BodyStyle}"
                                           Margin="0,0,0,8"/>

                                <!-- Slider Control -->
                                <Slider x:Name="SliderConcurrency"
                                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Minimum="1" Maximum="20" Value="5"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,0,16,0" VerticalAlignment="Center"/>

                                <!-- Value Display -->
                                <Border Grid.Row="1" Grid.Column="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource ElectricCyanBrush}"
                                        BorderThickness="1" Padding="12,6" MinWidth="50">
                                    <TextBlock x:Name="TxtConcurrencyValue"
                                               Text="5" Foreground="{StaticResource ElectricCyanBrush}"
                                               FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Preset Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnConcurrencyLow"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="保守 (3)" Click="BtnConcurrencyPreset_Click"
                                        Tag="3" Margin="0,0,8,0" Padding="12,6"/>
                                <Button x:Name="BtnConcurrencyNormal"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="标准 (5)" Click="BtnConcurrencyPreset_Click"
                                        Tag="5" Margin="0,0,8,0" Padding="12,6"/>
                                <Button x:Name="BtnConcurrencyHigh"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="高速 (10)" Click="BtnConcurrencyPreset_Click"
                                        Tag="10" Margin="0,0,8,0" Padding="12,6"/>
                                <Button x:Name="BtnConcurrencyMax"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="极限 (20)" Click="BtnConcurrencyPreset_Click"
                                        Tag="20" Padding="12,6"/>
                            </StackPanel>

                            <!-- Description -->
                            <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,0,0,16"
                                       TextWrapping="Wrap">
                                <Run Text="• 保守模式：" Foreground="{StaticResource ElectricCyanBrush}"/>
                                <Run Text="适合免费版API，避免触发限流" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <LineBreak/>
                                <Run Text="• 标准模式：" Foreground="{StaticResource ElectricCyanBrush}"/>
                                <Run Text="平衡速度和稳定性，推荐大多数用户" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <LineBreak/>
                                <Run Text="• 高速模式：" Foreground="{StaticResource ElectricCyanBrush}"/>
                                <Run Text="需要基础版以上API套餐" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <LineBreak/>
                                <Run Text="• 极限模式：" Foreground="{StaticResource ElectricCyanBrush}"/>
                                <Run Text="需要专业版API，最大化翻译吞吐量" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </TextBlock>

                            <!-- RPM Limit Section -->
                            <Border BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,0,0,8"/>

                            <TextBlock Text="RPM 限制（每分钟最大请求数）" Style="{StaticResource BodyStyle}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- RPM Slider -->
                                <Slider x:Name="SliderRpm"
                                        Grid.Row="0" Grid.Column="0"
                                        Minimum="10" Maximum="2000" Value="800"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        Margin="0,0,16,0" VerticalAlignment="Center"
                                        ValueChanged="SliderRpm_ValueChanged"/>

                                <!-- RPM Value Display -->
                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource ElectricCyanBrush}"
                                        BorderThickness="1" Padding="12,6" MinWidth="50">
                                    <TextBlock x:Name="TxtRpmValue"
                                               Text="800" Foreground="{StaticResource ElectricCyanBrush}"
                                               FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- RPM Preset Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnRpmConservative"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="保守 (100)" Click="BtnRpmPreset_Click"
                                        Tag="100" Margin="0,0,8,0" Padding="12,6"/>
                                <Button x:Name="BtnRpmNormal"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="标准 (300)" Click="BtnRpmPreset_Click"
                                        Tag="300" Margin="0,0,8,0" Padding="12,6"/>
                                <Button x:Name="BtnRpmHigh"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="高速 (800)" Click="BtnRpmPreset_Click"
                                        Tag="800" Margin="0,0,8,0" Padding="12,6"/>
                                <Button x:Name="BtnRpmMax"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="极限 (1500)" Click="BtnRpmPreset_Click"
                                        Tag="1500" Padding="12,6"/>
                            </StackPanel>

                            <!-- RPM Description -->
                            <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,0,0,16"
                                       TextWrapping="Wrap">
                                <Run Text="• RPM 限制用于保护云端 API 不被触发限流（429）" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <LineBreak/>
                                <Run Text="• 超过 RPM 限制时自动切换到备用翻译服务" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <LineBreak/>
                                <Run Text="• 建议根据你的 API 套餐额度设置" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </TextBlock>

                            <!-- Batch Translation Section -->
                            <TextBlock Text="批量翻译" Style="{StaticResource H2Style}"
                                       Margin="0,16,0,16"/>
                            <Border BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="0,0,0,1" Margin="0,0,0,16" Padding="0,0,0,8"/>

                            <!-- Batch Mode Toggle -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="启用批量翻译" Style="{StaticResource BodyStyle}"/>
                                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap">
                                        <Run Text="将多条翻译请求合并为一次 API 调用，大幅降低 Token 消耗和请求延迟" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>

                                <CheckBox x:Name="ChkBatchEnabled"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="True"/>
                            </Grid>

                            <!-- Batch Size Setting -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="批量大小（条）" Style="{StaticResource BodyStyle}"
                                           Margin="0,0,0,8"/>

                                <Slider x:Name="SliderBatchSize"
                                        Grid.Row="1" Grid.Column="0"
                                        Minimum="2" Maximum="20" Value="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,0,16,0" VerticalAlignment="Center"
                                        ValueChanged="SliderBatchSize_ValueChanged"/>

                                <Border Grid.Row="1" Grid.Column="1"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource ElectricCyanBrush}"
                                        BorderThickness="1" Padding="12,6" MinWidth="50">
                                    <TextBlock x:Name="TxtBatchSizeValue"
                                               Text="10" Foreground="{StaticResource ElectricCyanBrush}"
                                               FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Batch Description -->
                            <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,0,0,16"
                                       TextWrapping="Wrap">
                                <Run Text="• 批量大小：触发批量发送的队列条数阈值，10条表示凑够10条立即发送" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <LineBreak/>
                                <Run Text="• 滑动窗口：首批到达后启动200ms窗口，窗口内到达的请求自动合并，凑满后立即发送" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <LineBreak/>
                                <Run Text="• 建议：游戏翻译使用默认配置（10条），网页/文档翻译可增大批量" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </TextBlock>

                            <!-- Language Section -->
                            <TextBlock Text="语言设置" Style="{StaticResource H2Style}"
                                       Margin="0,0,0,16"/>
                            <Border BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="0,0,0,1" Margin="0,0,0,16" Padding="0,0,0,8"/>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="源语言" Style="{StaticResource BodyStyle}" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="CmbSourceLang"
                                              Style="{StaticResource CyberComboBoxStyle}">
                                        <ComboBoxItem Content="日语 (Japanese)"/>
                                        <ComboBoxItem Content="英语 (English)"/>
                                        <ComboBoxItem Content="韩语 (Korean)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="目标语言" Style="{StaticResource BodyStyle}" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="CmbTargetLang"
                                              Style="{StaticResource CyberComboBoxStyle}">
                                        <ComboBoxItem Content="简体中文" IsSelected="True"/>
                                        <ComboBoxItem Content="繁体中文"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <Border BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="💾 保存配置" Click="BtnSaveConfig_Click" Margin="0,0,16,0"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="🔗 测试连接" Click="BtnTestConnection_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Config Status -->
                            <TextBlock x:Name="LblConfigStatus" Style="{StaticResource CaptionStyle}"
                                       Margin="0,16,0,0"/>

                            <!-- Hints -->
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderDimBrush}"
                                    Padding="16" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,0,0,4">
                                        <Run Text="硅基流动" Foreground="{StaticResource ElectricCyanBrush}"/>
                                        <Run Text=" — 新用户注册实名认证后赠送16元额度" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" TextWrapping="Wrap">
                                        注册地址: cloud.siliconflow.cn
                                    </TextBlock>
                                    <Border Background="#1AE8E8E8" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="张先森的邀请码：" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtInviteCode"
                                                     Text="XkHbYgal"
                                                     IsReadOnly="True"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource ElectricCyanBrush}"
                                                     FontWeight="Bold"
                                                     FontSize="14"
                                                     VerticalAlignment="Center"
                                                     Cursor="Arrow"/>
                                            <Button x:Name="BtnCopyInviteCode"
                                                    Content="复制"
                                                    Style="{StaticResource TextButtonStyle}"
                                                    Width="50" Height="30"
                                                    FontSize="13"
                                                    Margin="12,0,0,0"
                                                    Click="BtnCopyInviteCode_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- About Page -->
            <Grid x:Name="AboutPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- About Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,0">
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Image x:Name="AboutLogo"
                               Source="pack://application:,,,/Resources/Images/logo.png"
                               Width="64" Height="64"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True"
                               SnapsToDevicePixels="True"/>
                    </Grid>
                    <TextBlock Text="{x:Static local:AppBasicInfoManager.AppDisplayName}"
                               Style="{StaticResource DisplayStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <Border BorderBrush="{StaticResource ElectricCyanBrush}"
                            BorderThickness="1" Padding="12,4"
                            HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="{x:Static local:AppBasicInfoManager.AppVersion}"
                                   Foreground="{StaticResource ElectricCyanBrush}"
                                   FontSize="12"/>
                    </Border>
                    <TextBlock Text="{x:Static local:AppBasicInfoManager.AboutDescription}"
                               Style="{StaticResource BodyStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="600"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- About Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,48,0,0">
                    <StackPanel>
                        <!-- About Card -->
                        <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static local:AppBasicInfoManager.CardTitleAboutUs}" Style="{StaticResource H2Style}" Margin="0,0,0,16"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8">
                                        <Run Text="• 项目创始人："/><Run Text="{x:Static local:AppBasicInfoManager.Founder}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,16">
                                        <Run Text="• 交流QQ群："/><Run Text="{x:Static local:AppBasicInfoManager.QQGroupNumber}" Foreground="{StaticResource ElectricCyanBrush}"/>
                                    </TextBlock>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderDimBrush}"
                                            BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap">
                                            <Run Text="{x:Static local:AppBasicInfoManager.QQGroupDescription}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Foreground="{StaticResource TertiaryTextBrush}">
                                        <Run Text="💡 版本更新将最先在 QQ 群发布，敬请关注"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tech Stack Card -->
                        <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static local:AppBasicInfoManager.CardTitleTechStack}" Style="{StaticResource H2Style}" Margin="0,0,0,16"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8">
                                        <Run Text="• 前端框架："/><Run Text="{x:Static local:AppBasicInfoManager.TechFrontend}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8">
                                        <Run Text="• AI 服务："/><Run Text="{x:Static local:AppBasicInfoManager.TechAIService}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8">
                                        <Run Text="• 翻译插件："/><Run Text="{x:Static local:AppBasicInfoManager.TechTranslatePlugin}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BodyStyle}">
                                        <Run Text="• 插件框架："/><Run Text="{x:Static local:AppBasicInfoManager.TechPluginFramework}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Changelog Card -->
                        <Border Style="{StaticResource CyberCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static local:AppBasicInfoManager.CardTitleChangelog}" Style="{StaticResource H2Style}" Margin="0,0,0,16"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,8">
                                        <Run Text="{x:Static local:AppBasicInfoManager.ChangelogV100}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,0,0,4"
                                               Text="{x:Static local:AppBasicInfoManager.ChangelogV100Item1}"/>
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               Text="{x:Static local:AppBasicInfoManager.ChangelogV100Item2}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource SecondaryBlackBrush}"
                BorderBrush="{StaticResource BorderDimBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock Text="{x:Static local:AppBasicInfoManager.AppFooter}"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
