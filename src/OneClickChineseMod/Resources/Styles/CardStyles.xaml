<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CyberCardStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource SecondaryBlackBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="CyberCardSelectedStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource SecondaryBlackBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource ElectricCyanBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="CyberCardHoverStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource SecondaryBlackBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

</ResourceDictionary>
